# Evee - Environment Variables
# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server Secrets & Encryption
# 32-byte hex string (64 characters) for AES-256-GCM OAuth token encryption at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=your-random-session-secret-change-this

# Google OAuth & Gmail API (for approved outbound sending)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# AI Provider Configuration (mock, openai, anthropic, or gemini)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Discovery Provider Configuration (mock or google_places)
DISCOVERY_PROVIDER=mock
DISCOVERY_API_KEY=

# Vercel Cron Secret (Authentication for /api/cron/process-jobs)
CRON_SECRET=your-cron-secret-for-scheduled-jobs

# Safety, Limits & Policy Defaults
ENABLE_AUTOMATED_SENDING=false
DAILY_SEND_LIMIT=5
MONTHLY_NEW_LEAD_TARGET=100
MAX_PAGES_PER_RESEARCH_RUN=5
MAX_MONTHLY_SPEND_INR=0
